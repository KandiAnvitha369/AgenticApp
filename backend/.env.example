# ==============================================================================
# Backend API Service Environment Configuration Example
# ==============================================================================

# LLM Generation Providers (Used ONLY for text response generation, NOT embeddings)
AWS_REGION=ap-southeast-2
BEDROCK_LLM_MODEL=amazon.nova-lite-v1:0
GROQ_API_KEY=your_groq_api_key
PAGEINDEX_API_KEY=your_pageindex_api_key
OPENAI_API_KEY=your_openai_api_key

# S3 Document Storage
S3_BUCKET_NAME=upload-files-377074487303-ap-southeast-2-an

# Dedicated SentenceTransformers Embedding Service (all-MiniLM-L6-v2, 384 dims)
EMBEDDING_SERVICE_URL=http://localhost:8001
EMBEDDING_DIMS=384

# Shared FAISS Vector Store on Amazon EFS
FAISS_PERSIST_DIR=faiss_store

# API Security & Server
ADMIN_API_KEY=your_admin_key
ENV=production
PORT=8000
