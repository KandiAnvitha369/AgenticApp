# ==============================================================================
# SQS Consumer Worker Service Environment Configuration
# ==============================================================================

# AWS Configuration
AWS_REGION=ap-southeast-2
SQS_QUEUE_NAME=file-vector-queue
SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/377074487303/file-vector-queue
S3_BUCKET_NAME=upload-files-377074487303-ap-southeast-2-an

# Dedicated SentenceTransformers Embedding Service (NO AWS BEDROCK EMBEDDINGS)
EMBEDDING_SERVICE_URL=http://localhost:8001
EMBEDDING_DIMS=384

# Shared FAISS Vector Store on Amazon EFS
FAISS_PERSIST_DIR=faiss_store
SQS_STAGING_DIR=data/sqs_staging
ENV=production
